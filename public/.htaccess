<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Upload limits for hosts that run PHP inside the web server (mod_php,
# LiteSpeed, mod_lsapi). PHP-FPM / CGI hosts read public/.user.ini instead.
# Each block only applies when its module is loaded, so this never causes a
# 500 on hosts where php_value is not allowed. Keep in sync with .user.ini.
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 128M
    php_value max_file_uploads 30
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 128M
    php_value max_file_uploads 30
</IfModule>
<IfModule lsapi_module>
    php_value upload_max_filesize 64M
    php_value post_max_size 128M
    php_value max_file_uploads 30
</IfModule>
<IfModule Litespeed>
    php_value upload_max_filesize 64M
    php_value post_max_size 128M
    php_value max_file_uploads 30
</IfModule>

# Compress text responses (HTML, JSON, JS, CSS, SVG).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Vite build assets carry content-hashed filenames, so a changed file always
# gets a new URL and browsers can cache it for a year. Uploads are mostly
# random names too, but seeded files reuse fixed names, so cache them a week.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/build/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/uploads/#">
        Header set Cache-Control "public, max-age=604800"
    </ElseIf>
</IfModule>
